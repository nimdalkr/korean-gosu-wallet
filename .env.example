# Dashboard access. Use long random values in production.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Strongly recommended for internet-reachable deployments behind Cloudflare Access.
# When enabled, all three values below are required and the allowlist must be non-empty.
REQUIRE_UPSTREAM_AUTH=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=
ALLOWED_ACCESS_IDENTITIES=

# Trust forwarding IP headers only when the origin is reachable exclusively through your proxy.
# Otherwise all direct clients intentionally share one conservative throttle bucket.
LOGIN_TRUST_PROXY_HEADERS=false

# Optional. Without a key, the collector uses the public Base Blockscout API.
# Leave blank to select the PRO Base URL automatically when a key is present.
# Blockscout PRO Base URL: https://api.blockscout.com/8453/api/v2
BLOCKSCOUT_API_BASE=
BLOCKSCOUT_API_KEY=

# Collector tuning. The checked-in workflow uses a 4-hour incremental refresh.
TRACKING_WINDOW_DAYS=30
COLLECTOR_WORKERS=10
REQUEST_INTERVAL_MS=230
INCREMENTAL_MAX_PAGES=500
RECONCILE_MAX_PAGES=500
MAX_API_REQUESTS_PER_RUN=4500
